+++ b/apps/api/experiments/phase0/queries.ts
@@ -0,0 +1,8 @@
+import { Kysely, PostgresDialect } from "kysely";
+import type pg from "pg";
+export interface ProofDatabase {
+  record: { id: string; ownerId: string; text: string };
+}
+export function createQueries(pool: pg.Pool) {
+  return new Kysely<ProofDatabase>({ dialect: new PostgresDialect({ pool }) });
+}
