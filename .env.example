# Actual local secrets are generated outside the checkout by pnpm env:init.
# See README.md for their locations. These examples contain no usable passwords.
WEB_PORT=5173
DB_POOL_SIZE=5
APP_ORIGIN=http://localhost:5173
# Generated once by env:init; preserve it for sessions and encrypted email payloads.
AUTH_SECRET=replace-with-generated-secret-at-least-48-characters
NOOLA_MIGRATION_PASSWORD=replace-with-generated-secret
NOOLA_APP_PASSWORD=replace-with-generated-secret
