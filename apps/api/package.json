{
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "name": "@noola/api",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:provision": "tsx scripts/provision.ts",
    "test:integration": "tsx scripts/integration.ts",
    "phase0:runtime": "tsx experiments/phase0/run.ts",
    "phase0:typecheck": "tsc -p experiments/phase0/tsconfig.json",
    "phase0:generate": "drizzle-kit generate --config experiments/phase0/drizzle.config.ts",
    "phase0:declarations": "tsc -p experiments/phase0/tsconfig.json --skipLibCheck false"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@noola/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@openai/codex-sdk": "0.160.0",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.7",
    "drizzle-kit": "0.31.11"
  }
}
